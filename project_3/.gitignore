# Results (regenerable - keep directory structure)
# Exact counter results
results/exact/*.csv
results/exact/*.json
results/exact/*.pkl

# Fixed probability counter results
results/fixed_prob/*.csv
results/fixed_prob/*.json
results/fixed_prob/*.pkl

# Space-Saving results
results/space_saving/*.csv
results/space_saving/*.json
results/space_saving/*.pkl

# Comparison results
results/comparison/*.csv
results/comparison/*.json
results/comparison/*.pkl

# Efficiency results
results/efficiency/*.csv
results/efficiency/*.json
results/efficiency/*.pkl
results/efficiency/*.txt

# All figures (regenerable)
results/figures/**/*.png
results/figures/**/*.pdf
results/figures/**/*.svg
results/figures/**/*.jpg
results/figures/**/*.jpeg

# Keep directory structure with .gitkeep files
!results/exact/.gitkeep
!results/fixed_prob/.gitkeep
!results/space_saving/.gitkeep
!results/comparison/.gitkeep
!results/figures/exploratory/.gitkeep
!results/figures/fixed_prob/.gitkeep
!results/figures/space_saving/.gitkeep
!results/figures/comparison/.gitkeep

